# Binance API credentials
# Get these from https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading mode: "paper" (simulated) or "live" (real money)
# ALWAYS start with paper mode to validate your strategy first!
TRADING_MODE=paper

# Trading pairs to watch (comma-separated). Leave blank to scan ALL markets automatically.
TRADING_PAIRS=

# Market scanning (used when TRADING_PAIRS is blank)
SCAN_ALL_MARKETS=true
MIN_VOLUME_USDT=5000000        # Ignore pairs with less than this 24h USDT volume
TOP_OPPORTUNITIES=5            # Open positions in top N signals per cycle
REBALANCE=true                 # Sell weak holdings when stronger signals appear

# Strategy: "sma_crossover", "rsi", or "combined"
STRATEGY=combined

# Timeframe for candles: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=15m

# Risk management
MAX_POSITION_SIZE_PCT=5.0      # Max % of portfolio per trade
STOP_LOSS_PCT=1.5              # Stop loss percentage
TAKE_PROFIT_PCT=3.0            # Take profit percentage
MAX_OPEN_POSITIONS=5           # Max simultaneous open positions
MAX_DAILY_LOSS_PCT=10.0        # Circuit breaker: halt if daily loss exceeds this %

# SMA strategy settings (tuned for 15m)
SMA_FAST_PERIOD=8
SMA_SLOW_PERIOD=21

# RSI strategy settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
